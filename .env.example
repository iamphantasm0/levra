# Levra environment variables
# Copy this file to .env and fill in your values. Never commit .env.

# ---------------------------------------------------------------------------
# LLM (required)
# ---------------------------------------------------------------------------
# Claude is reached through the OpenRouter gateway using the OpenAI-compatible
# SDK - hence OPENROUTER_API_KEY, not ANTHROPIC_API_KEY. Without this, POST
# /spec returns 503. Keys: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# On-chain spec logging (all three required together, or logging stays off)
# ---------------------------------------------------------------------------
# X Layer network. Chain IDs confirmed against eth_chainId on 2026-08-14:
#   mainnet  chain id 196   https://rpc.xlayer.tech
#   testnet  chain id 1952  https://testrpc.xlayer.tech/terigon
# NOTE: testnet is 1952, NOT 195. The widely cached "195" is the retired zkEVM
# testnet; X Layer has since migrated to the OP Stack.
XLAYER_RPC_URL=
XLAYER_CHAIN_ID=196

# Address of the deployed LevraLog contract on the chain above.
LEVRA_LOG_ADDRESS=

# Private key of the account that pays gas for log writes. Fund it with OKB.
# Use a dedicated hot key holding only gas money - never a treasury key.
CHAIN_LOGGER_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# x402 payments
# ---------------------------------------------------------------------------
# Where callers actually send payment. There is deliberately no default: unset
# means the 402 challenge names no payee, which is logged as an error. It must
# never fall back to the zero address - funds sent there are burned.
X402_PAY_TO_ADDRESS=

# CAIP-2 network id for settlement. Defaults to eip155:196 (X Layer mainnet).
X402_NETWORK=eip155:196
X402_PRICE=1.00
X402_DENOMINATION=USDC

# ---------------------------------------------------------------------------
# Foundry (contract deploy only - not read by the app)
# ---------------------------------------------------------------------------
XLAYER_TESTNET_RPC=https://testrpc.xlayer.tech/terigon
XLAYER_MAINNET_RPC=https://rpc.xlayer.tech
# LEVRA_DEPLOYER_KEY=
